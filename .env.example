# Email Configuration (Gmail with App Password)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=hkua ghvs fmqh udef

# WhatsApp Configuration (FREE options prioritized)
# System tries FREE providers first, then paid options

# === FREE OPTIONS ===

# Option 1: Ultramsg (FREE - up to 100 messages/month)
# Signup at https://ultramsg.com
ULTRAMSG_INSTANCE_ID=your_ultramsg_instance_id
ULTRAMSG_TOKEN=your_ultramsg_token

# Option 2: CallMeBot (FREE - requires WhatsApp friend setup)
# Signup at https://callmebot.com
CALLMEBOT_API_KEY=your_callmebot_api_key

# === PAID OPTIONS (only if free options don't work) ===

# Option 3: Waboxapp (PAID)
# Signup at https://waboxapp.com
WABOXAPP_API_KEY=your_waboxapp_api_key
WABOXAPP_UID=your_waboxapp_uid

# Option 4: Twilio (PAID - most reliable)
# Signup at https://twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number

# Owner WhatsApp number (international format, e.g. +31631234567)
RESTAURANT_WHATSAPP_PHONE=+31631234567

# SMTP (Nodemailer) - required for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Chopras <info@chopras.nl>
NOTIFY_EMAIL=info@chopras.nl

# Baileys WhatsApp (file-based auth)
NOTIFY_WHATSAPP_NUMBER=918178573528
BAILEYS_AUTH_DIR=data/baileys_auth

# Persistence (optional)
DATA_DIR=data
DATABASE_FILE=
